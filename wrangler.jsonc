{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name. It becomes part of your free address: https://binwright-lite.<your-subdomain>.workers.dev
  "name": "binwright-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  // Built CSS, client JS and icons. Files here are served directly; everything else goes to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Database. On the first `wrangler deploy` (or the Deploy to Cloudflare button) Cloudflare creates it for you and
  // writes its id here. There is no id in this file on purpose.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "binwright-lite",
      "migrations_dir": "migrations",
    },
  ],
  // Slows down password guessing: 10 sign-in, sign-up or reset attempts per minute per visitor.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1301", "simple": { "limit": 10, "period": 60 } }],
  // Runs once a day at 15:00 UTC. In demo mode it wipes and reloads the demo data. Otherwise it does nothing.
  "triggers": { "crons": ["0 15 * * *"] },
  "vars": {
    // Your app's public address, with no trailing slash. Used in email links. Leave empty to use the request's address.
    "APP_URL": "",
    // "true" makes new users confirm their email before signing in. Needs email set up (see SETUP.md).
    "REQUIRE_EMAIL_VERIFICATION": "false",
    // The address emails come from. Its domain must be set up in Cloudflare Email Sending.
    "MAIL_FROM": "",
    // Default time zone (an IANA name such as Europe/London or America/Chicago). Can be changed on the Setup page.
    "TIME_ZONE": "UTC",
    // "true" turns on demo mode: demo sign-ins on the login page and a nightly reset. Never use with real stock.
    "DEMO_MODE": "false",
  },
  // To send email (verification and password reset), uncomment this after setting up Cloudflare Email Sending,
  // and fill in MAIL_FROM above:
  // "send_email": [{ "name": "EMAIL" }],
  //
  // Secrets are never written in this file. Set them with:  npx wrangler secret put AUTH_SECRET
  //   AUTH_SECRET  a long random string that signs sign-in sessions (see SETUP.md for a one-line generator)
}
